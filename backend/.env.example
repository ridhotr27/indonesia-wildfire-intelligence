# Application settings. Never commit a populated .env file.
WILDFIRE_ENVIRONMENT=development
WILDFIRE_LOG_LEVEL=INFO
WILDFIRE_API_PREFIX=/api/v1
WILDFIRE_MAX_GEOJSON_FEATURES=500
WILDFIRE_MAX_DATE_RANGE_DAYS=366
# Comma-delimited browser origins; empty means no cross-origin browser access.
WILDFIRE_CORS_ORIGINS=

# B05 public-service bounds. Set a high-entropy client ID salt in production.
WILDFIRE_MAX_REQUEST_BODY_BYTES=65536
WILDFIRE_REQUEST_TIMEOUT_SECONDS=120
WILDFIRE_PER_CLIENT_REQUESTS_PER_MINUTE=30
WILDFIRE_GLOBAL_REQUESTS_PER_MINUTE=300
WILDFIRE_MAX_CONCURRENT_REQUESTS=20
WILDFIRE_CLIENT_ID_SALT=

# B02 analytics adapter. Keep mock unless a DE-published database and read-only role exist.
WILDFIRE_ANALYTICS_BACKEND=mock
WILDFIRE_CLICKHOUSE_URL=http://127.0.0.1:8123
WILDFIRE_CLICKHOUSE_DATABASE=wildfire
WILDFIRE_CLICKHOUSE_USERNAME=wildfire_reader
WILDFIRE_CLICKHOUSE_PASSWORD=
WILDFIRE_CLICKHOUSE_TIMEOUT_SECONDS=5
WILDFIRE_AGENT_PLANNER_BACKEND=deterministic
# LIR-05 remains isolated from runtime until LIR-09 approval.
WILDFIRE_INTENT_PLANNING_MODE=disabled
WILDFIRE_INTENT_PLANNER_MODEL_NAME=qwen2.5:1.5b
WILDFIRE_INTENT_PLANNER_TIMEOUT_SECONDS=8
WILDFIRE_INTENT_PLANNER_MAX_TOKENS=512
# Set local_grounded only with the complete pinned B12 profile below.
WILDFIRE_ASSISTANT_PROFILE=degraded
WILDFIRE_AGENT_MAX_GRAPH_STEPS=6
WILDFIRE_AGENT_MAX_TOOL_CALLS=2
WILDFIRE_AGENT_TIMEOUT_SECONDS=120
WILDFIRE_AGENT_MAX_RETRIEVED_CHARACTERS=3000
WILDFIRE_AGENT_MAX_MODEL_TOKENS=192

# Deterministic extractive answers work without a model service. Set ollama only
# for the separately evaluated local generation profile below.
WILDFIRE_AGENT_MODEL_PROVIDER=extractive
WILDFIRE_AGENT_MODEL_NAME=qwen2.5:1.5b
WILDFIRE_OLLAMA_BASE_URL=http://127.0.0.1:11434
WILDFIRE_OLLAMA_TIMEOUT_SECONDS=120
WILDFIRE_AGENT_COMBINED_STAGE_BUDGETING=true

# B06/B07 local RAG. Build this index once with the README command before startup.
WILDFIRE_RAG_BACKEND=local
WILDFIRE_QDRANT_PATH=data/qdrant-local-hashing
WILDFIRE_QDRANT_COLLECTION=nasa_firms_documents_v1
WILDFIRE_RAG_RETRIEVAL_PROFILE=hybrid_rrf
WILDFIRE_RAG_CHUNKING_PROFILE=recursive-character-1400-200-v1
WILDFIRE_EMBEDDING_PROVIDER=hashing
WILDFIRE_EMBEDDING_MODEL_NAME=all-minilm

# LIR-09 active semantic-only routing uses local Ollama all-minilm independently of
# the NASA RAG provider above. Set disabled to restore deterministic-only routing.
WILDFIRE_SEMANTIC_ROUTING_MODE=disabled
WILDFIRE_SEMANTIC_INTENT_PATH=data/semantic-intents
WILDFIRE_SEMANTIC_INTENT_COLLECTION=analytics_intent_examples_v1

# B12 coherent local profile:
# WILDFIRE_ASSISTANT_PROFILE=local_grounded
# WILDFIRE_RAG_BACKEND=local
# WILDFIRE_EMBEDDING_PROVIDER=ollama
# WILDFIRE_EMBEDDING_MODEL_NAME=all-minilm
# WILDFIRE_AGENT_MODEL_PROVIDER=ollama
# WILDFIRE_AGENT_MODEL_NAME=qwen2.5:1.5b

# Reserved for later integrations.
# WILDFIRE_OPENAI_API_KEY=
