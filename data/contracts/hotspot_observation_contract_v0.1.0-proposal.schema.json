{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:indonesia-wildfire:contracts:hotspot-observation:0.1.0-proposal",
  "title": "Canonical FIRMS hotspot observation v0.1.0 proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "product_id",
    "source_product",
    "collection_version",
    "processing_stream",
    "satellite_code",
    "satellite_name",
    "instrument",
    "acquired_at_utc",
    "latitude",
    "longitude",
    "brightness_i4_kelvin",
    "brightness_i5_kelvin",
    "scan_km",
    "track_km",
    "frp_mw",
    "confidence_code",
    "confidence_label",
    "daynight_code",
    "hotspot_type_code",
    "province_code",
    "province_name",
    "geo_assignment_status",
    "geo_assignment_method",
    "boundary_source_id",
    "ingestion_batch_id",
    "source_row_number",
    "source_record_hash",
    "quality_flags"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0-proposal"},
    "observation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "product_id": {"const": "VNP14IMG.002_SNPP_FIRMS_SP"},
    "source_product": {"const": "VNP14IMG"},
    "collection_version": {"const": "2"},
    "processing_stream": {"const": "standard"},
    "satellite_code": {"const": "N"},
    "satellite_name": {"const": "Suomi NPP"},
    "instrument": {"const": "VIIRS"},
    "acquired_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "latitude": {"type": "number", "minimum": -90, "maximum": 90},
    "longitude": {"type": "number", "minimum": -180, "maximum": 180},
    "brightness_i4_kelvin": {"type": "number"},
    "brightness_i5_kelvin": {"type": "number"},
    "scan_km": {"type": "number", "exclusiveMinimum": 0},
    "track_km": {"type": "number", "exclusiveMinimum": 0},
    "frp_mw": {"type": "number", "minimum": 0},
    "confidence_code": {"enum": ["l", "n", "h"]},
    "confidence_label": {"enum": ["low", "nominal", "high"]},
    "daynight_code": {"enum": ["D", "N"]},
    "hotspot_type_code": {"type": "integer", "minimum": 0, "maximum": 3},
    "province_code": {"type": ["string", "null"], "pattern": "^[0-9]{2}$"},
    "province_name": {"type": ["string", "null"], "minLength": 1},
    "geo_assignment_status": {
      "enum": ["assigned", "unassigned", "ambiguous_boundary", "multiple_match"]
    },
    "geo_assignment_method": {
      "enum": ["big_full_resolution_point_intersection", "big_generalized_feasibility_only", "none"]
    },
    "boundary_source_id": {"type": ["string", "null"]},
    "ingestion_batch_id": {"type": "string", "minLength": 1},
    "source_row_number": {"type": "integer", "minimum": 1},
    "source_record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "quality_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "zero_frp",
          "source_exact_duplicate",
          "geo_unassigned",
          "geo_ambiguous_boundary",
          "geo_multiple_match",
          "known_coverage_gap_context",
          "source_category_unexpected"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"geo_assignment_status": {"const": "assigned"}}},
      "then": {
        "properties": {
          "province_code": {"type": "string"},
          "province_name": {"type": "string"}
        }
      },
      "else": {
        "properties": {
          "province_code": {"type": "null"},
          "province_name": {"type": "null"}
        }
      }
    }
  ]
}
