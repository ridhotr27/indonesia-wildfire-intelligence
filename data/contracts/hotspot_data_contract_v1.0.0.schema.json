{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:indonesia-wildfire:contracts:hotspot-data:1.0.0",
  "title": "Indonesia Wildfire Intelligence DE-to-BE hotspot data contract v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_classification",
    "contract_version",
    "observations",
    "daily_coverage",
    "provinces",
    "ingestion_batches",
    "reference_queries"
  ],
  "properties": {
    "fixture_classification": {"const": "synthetic_contract_example"},
    "contract_version": {"const": "1.0.0"},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "daily_coverage": {"type": "array", "items": {"$ref": "#/$defs/dailyCoverage"}},
    "provinces": {"type": "array", "items": {"$ref": "#/$defs/province"}},
    "ingestion_batches": {"type": "array", "items": {"$ref": "#/$defs/ingestionBatch"}},
    "reference_queries": {"type": "array", "items": {"$ref": "#/$defs/referenceQuery"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utcTimestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version", "observation_id", "product_id", "source_product",
        "collection_version", "processing_stream", "satellite_code", "satellite_name",
        "instrument", "acquired_at_utc", "latitude", "longitude",
        "brightness_i4_kelvin", "brightness_i5_kelvin", "scan_km", "track_km",
        "frp_mw", "confidence_code", "confidence_label", "daynight_code",
        "hotspot_type_code", "province_code", "province_name", "geo_assignment_status",
        "geo_assignment_method", "boundary_source_id", "ingestion_batch_id",
        "source_row_number", "source_record_hash", "quality_flags"
      ],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "observation_id": {"$ref": "#/$defs/sha256"},
        "product_id": {"const": "VNP14IMG.002_SNPP_FIRMS_SP"},
        "source_product": {"const": "VNP14IMG"},
        "collection_version": {"const": "2"},
        "processing_stream": {"const": "standard"},
        "satellite_code": {"const": "N"},
        "satellite_name": {"const": "Suomi NPP"},
        "instrument": {"const": "VIIRS"},
        "acquired_at_utc": {"$ref": "#/$defs/utcTimestamp"},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "brightness_i4_kelvin": {"type": "number"},
        "brightness_i5_kelvin": {"type": "number"},
        "scan_km": {"type": "number", "exclusiveMinimum": 0},
        "track_km": {"type": "number", "exclusiveMinimum": 0},
        "frp_mw": {"type": "number", "minimum": 0},
        "confidence_code": {"enum": ["l", "n", "h"]},
        "confidence_label": {"enum": ["low", "nominal", "high"]},
        "daynight_code": {"enum": ["D", "N"]},
        "hotspot_type_code": {"type": "integer", "minimum": 0, "maximum": 3},
        "province_code": {"type": ["string", "null"], "pattern": "^[0-9]{2}$"},
        "province_name": {"type": ["string", "null"], "minLength": 1},
        "geo_assignment_status": {"enum": ["assigned", "unassigned", "multiple_match"]},
        "geo_assignment_method": {"enum": ["osm_snapshot_point_intersection", "none"]},
        "boundary_source_id": {"type": ["string", "null"]},
        "ingestion_batch_id": {"type": "string", "minLength": 1},
        "source_row_number": {"type": "integer", "minimum": 1},
        "source_record_hash": {"$ref": "#/$defs/sha256"},
        "quality_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["zero_frp", "source_exact_duplicate", "geo_unassigned", "geo_multiple_match", "known_coverage_gap_context", "source_category_unexpected"]}
        }
      }
    },
    "dailyCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "product_id", "date_utc", "coverage_status", "observation_count", "evidence_url", "note", "ingestion_batch_id"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "product_id": {"const": "VNP14IMG.002_SNPP_FIRMS_SP"},
        "date_utc": {"type": "string", "format": "date"},
        "coverage_status": {"enum": ["observations_present", "known_satellite_gap", "zero_detections_verified", "unknown"]},
        "observation_count": {"type": ["integer", "null"], "minimum": 0},
        "evidence_url": {"type": ["string", "null"], "format": "uri"},
        "note": {"type": ["string", "null"]},
        "ingestion_batch_id": {"type": ["string", "null"]}
      }
    },
    "province": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "province_code", "province_name", "source_code", "source_name", "boundary_source_id", "snapshot", "commit", "crs", "source_sha256", "canonical_sha256", "license", "license_url", "required_attribution", "is_supported"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "province_code": {"type": "string", "pattern": "^[0-9]{2}$"},
        "province_name": {"type": "string", "minLength": 1},
        "source_code": {"type": "string", "pattern": "^ID_[A-Z]{2}$"},
        "source_name": {"type": "string", "minLength": 1},
        "boundary_source_id": {"const": "osm-idn-adm1-2026-10-10b"},
        "snapshot": {"const": "2026-10-10b"},
        "commit": {"const": "c4d208a03a71553a1082f960ebdaa88c1d8e9389"},
        "crs": {"const": "OGC:CRS84"},
        "source_sha256": {"const": "9dd43439b284186c91a2443c9fb9e5eabb885f75597f1ab83221f43a7ef88de7"},
        "canonical_sha256": {"const": "e9bd1f1fb1ba39ea0e07a7ba71cbbb2f048e64d6b49316cad7e88689aade74dd"},
        "license": {"const": "ODbL-1.0"},
        "license_url": {"const": "https://opendatacommons.org/licenses/odbl/1-0/"},
        "required_attribution": {"const": "© OpenStreetMap contributors"},
        "is_supported": {"const": true}
      }
    },
    "ingestionBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "ingestion_batch_id", "product_id", "source_url", "source_artifact_sha256", "source_bytes", "retrieved_at_utc", "provider_last_modified_utc", "coverage_start_utc", "coverage_end_utc", "source_row_count", "canonical_row_count", "duplicate_excess_rows", "rejected_row_count", "transform_version", "provenance_manifest_path", "publication_status", "published_at_utc"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "ingestion_batch_id": {"type": "string", "minLength": 1},
        "product_id": {"const": "VNP14IMG.002_SNPP_FIRMS_SP"},
        "source_url": {"type": "string", "format": "uri"},
        "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "source_bytes": {"type": "integer", "minimum": 0},
        "retrieved_at_utc": {"$ref": "#/$defs/utcTimestamp"},
        "provider_last_modified_utc": {"anyOf": [{"$ref": "#/$defs/utcTimestamp"}, {"type": "null"}]},
        "coverage_start_utc": {"$ref": "#/$defs/utcTimestamp"},
        "coverage_end_utc": {"$ref": "#/$defs/utcTimestamp"},
        "source_row_count": {"type": "integer", "minimum": 0},
        "canonical_row_count": {"type": "integer", "minimum": 0},
        "duplicate_excess_rows": {"type": "integer", "minimum": 0},
        "rejected_row_count": {"type": "integer", "minimum": 0},
        "transform_version": {"type": "string", "minLength": 1},
        "provenance_manifest_path": {"type": "string", "minLength": 1},
        "publication_status": {"const": "published"},
        "published_at_utc": {"$ref": "#/$defs/utcTimestamp"}
      }
    },
    "referenceQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_id", "date_from", "date_to", "province_codes", "available_detection_total", "numeric_total_available", "is_complete", "coverage_issues"],
      "properties": {
        "query_id": {"type": "string", "minLength": 1},
        "date_from": {"type": "string", "format": "date"},
        "date_to": {"type": "string", "format": "date"},
        "province_codes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{2}$"}, "uniqueItems": true},
        "available_detection_total": {"type": ["integer", "null"], "minimum": 0},
        "numeric_total_available": {"type": "boolean"},
        "is_complete": {"type": "boolean"},
        "coverage_issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date_utc", "coverage_status"],
            "properties": {
              "date_utc": {"type": "string", "format": "date"},
              "coverage_status": {"enum": ["known_satellite_gap", "unknown"]}
            }
          }
        }
      }
    }
  }
}
