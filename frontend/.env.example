# Real mode is the safe default: it fails closed if verified data is unavailable.
WILDFIRE_FRONTEND_API_MODE=real

# Public (non-secret) browser-to-FastAPI URL, read at server runtime.
WILDFIRE_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Explicit local fixture mode only:
# WILDFIRE_FRONTEND_API_MODE=mock
