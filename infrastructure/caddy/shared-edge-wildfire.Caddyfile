# Owner-authorized Wildfire site appended to the VPS shared-edge Caddyfile.
# Portfolio site blocks remain in /opt/shared-edge/deploy/Caddyfile.
wildfire.ridhotrivo.com {
	encode zstd gzip
	request_body {
		max_size 64KB
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	@api path /api/v1/*
	handle @api {
		reverse_proxy wildfire-backend:8000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 125s
			}
		}
	}

	handle {
		reverse_proxy wildfire-frontend:3000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 125s
			}
		}
	}

	log {
		output stdout
		format json
	}
}
