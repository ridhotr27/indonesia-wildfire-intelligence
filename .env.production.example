# Copy to .env.production and replace every CHANGE_ME value. Never commit that file.
WILDFIRE_DOMAIN=wildfire.ridhotrivo.com
ACME_EMAIL=CHANGE_ME@example.com
WILDFIRE_PUBLIC_API_BASE_URL=https://wildfire.ridhotrivo.com/api/v1
WILDFIRE_CORS_ORIGINS=https://wildfire.ridhotrivo.com

GHCR_REGISTRY=ghcr.io
GHCR_OWNER=ridhotr27
# Immutable Git commit SHA published by CI.
IMAGE_TAG=CHANGE_ME_COMMIT_SHA

# Generate independent values, for example: openssl rand -base64 48
CLICKHOUSE_ADMIN_PASSWORD=CHANGE_ME
CLICKHOUSE_BACKEND_PASSWORD=CHANGE_ME
CLICKHOUSE_INGESTOR_PASSWORD=CHANGE_ME
WILDFIRE_CLIENT_ID_SALT=CHANGE_ME

# Shared-proxy integration. The portfolio proxy must join this external network.
EDGE_NETWORK=wildfire_edge
# CIDR assigned when creating the external edge network; only this proxy network is trusted.
TRUSTED_PROXY_CIDRS=172.30.0.0/24

# Stable, project-specific volume names. Do not rename during an update.
CLICKHOUSE_DATA_VOLUME=wildfire_clickhouse_data
CLICKHOUSE_LOG_VOLUME=wildfire_clickhouse_logs
RAG_INDEX_VOLUME=wildfire_rag_indexes
OLLAMA_MODEL_VOLUME=wildfire_ollama_models
CADDY_DATA_VOLUME=wildfire_caddy_data
CADDY_CONFIG_VOLUME=wildfire_caddy_config

# Host path to one checksum-verified ingestion batch; only used by data-loader.
DATA_BATCH_DIR=./data/derived/not-configured
DATA_BATCH_ID=set-to-the-verified-batch-directory-name

# Conservative starting limits for an 8 GiB VPS without local Ollama.
# These are not suitable for the reported shared 4 GiB host without an audit.
CLICKHOUSE_MEMORY_LIMIT=3g
CLICKHOUSE_CPU_LIMIT=2.0
BACKEND_MEMORY_LIMIT=1g
BACKEND_CPU_LIMIT=1.0
FRONTEND_MEMORY_LIMIT=512m
FRONTEND_CPU_LIMIT=0.75

# Optional local-llm profile is disabled by default. Pin the image digest and
# benchmark memory before enabling it on an approved private host.
OLLAMA_IMAGE_TAG=0.12.10
OLLAMA_MEMORY_LIMIT=1g
OLLAMA_CPU_LIMIT=1.0
WILDFIRE_OLLAMA_BASE_URL=http://127.0.0.1:11434
WILDFIRE_OLLAMA_INTERNAL_SERVICE=false
# Only after an approved private experiment and compatible index build:
WILDFIRE_ASSISTANT_PROFILE=degraded
WILDFIRE_AGENT_MODEL_PROVIDER=extractive
WILDFIRE_AGENT_MODEL_NAME=qwen2.5:1.5b
WILDFIRE_EMBEDDING_PROVIDER=hashing
WILDFIRE_RAG_INDEX_DIR=qdrant-local-hashing
RAG_INIT_INTERNAL_OLLAMA_FLAG=--no-internal-ollama

WILDFIRE_LOG_LEVEL=INFO
WILDFIRE_CLICKHOUSE_TIMEOUT_SECONDS=5
WILDFIRE_MAX_REQUEST_BODY_BYTES=65536
WILDFIRE_REQUEST_TIMEOUT_SECONDS=120
WILDFIRE_PER_CLIENT_REQUESTS_PER_MINUTE=30
WILDFIRE_GLOBAL_REQUESTS_PER_MINUTE=300
WILDFIRE_MAX_CONCURRENT_REQUESTS=20
WILDFIRE_AGENT_MAX_GRAPH_STEPS=6
WILDFIRE_AGENT_MAX_TOOL_CALLS=2
WILDFIRE_AGENT_TIMEOUT_SECONDS=120
WILDFIRE_AGENT_MAX_RETRIEVED_CHARACTERS=3000
WILDFIRE_AGENT_MAX_MODEL_TOKENS=192
